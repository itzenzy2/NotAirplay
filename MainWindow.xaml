<Window x:Class="NotAirplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NotAirplay"
        Title="NotAirplay"
        Width="960"
        Height="720"
        MinWidth="620"
        MinHeight="520"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AcousticStageFallbackBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="Window_KeyDown"
        Icon="assets/app.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#9B2216" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FpsSegmentButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AcousticLiveSubtleBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AcousticLiveBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AcousticLiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowOuterBorder" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid x:Name="RootShellGrid" SizeChanged="RootShellGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="44" />
            </Grid.RowDefinitions>

            <!-- Opaque Fluent Title Bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Margin="16,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/NotAirplay;component/assets/logo.png"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TitleBarBrandText"
                               Text="NotAirplay"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource AcousticLiveBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLabel"
                                       Text="Ready"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <ui:Button x:Name="PinButton"
                               Appearance="Transparent"
                               Padding="8,5"
                               Margin="0,0,6,0"
                               Click="Pin_Click"
                               ToolTip="Keep on top"
                               AutomationProperties.Name="Keep on top">
                        <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="15" />
                    </ui:Button>
                    <Button Style="{StaticResource WindowCaptionButton}"
                            Click="Minimize_Click"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M 0,5 H 10" Stroke="#E4E4E7" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="Maximize_Click"
                            ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 10 V 10 H 0 Z" Stroke="#E4E4E7" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Click="Close_Click"
                            ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#E4E4E7" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>

        <!-- Main Workspace Shell + Telemetry Drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="RootNav"
                               Grid.Column="0"
                               PaneDisplayMode="Left"
                               OpenPaneLength="188"
                               CompactPaneLength="48"
                               IsPaneOpen="True"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"
                               FrameMargin="0"
                               TransitionDuration="150">
                <ui:NavigationView.Resources>
                    <Style TargetType="{x:Type ui:NavigationViewContentPresenter}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ui:NavigationView.Resources>
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="NavReceiver"
                                           Content="Receiver"
                                           Tag="receiver"
                                           IsActive="True"
                                           Icon="{ui:SymbolIcon Cast24}"
                                           Click="NavReceiver_Click" />
                    <ui:NavigationViewItem x:Name="NavAudio"
                                           Content="Audio deck"
                                           Tag="audio"
                                           Icon="{ui:SymbolIcon DesktopSpeaker24}"
                                           Click="NavAudio_Click" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="NavTelemetry"
                                           Content="Diagnostics"
                                           Tag="diagnostics"
                                           Icon="{ui:SymbolIcon Pulse24}"
                                           Click="NavTelemetry_Click" />
                </ui:NavigationView.FooterMenuItems>

                <ui:NavigationView.ContentOverlay>
                    <Grid x:Name="Stage" Background="Transparent">
                        <!-- View 1: Receiver Standby / Connection Workspace -->
                        <Grid x:Name="ReceiverHome" Visibility="Visible">
                            <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="28,24,28,24">
                                    <!-- Top Hero Status Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="pack://application:,,,/NotAirplay;component/assets/logo.png"
                                               Width="52"
                                               Height="52"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeroTitle"
                                                       Text="Ready for your iPhone."
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="HeroDetail"
                                                       Text="Select NotAirplay in Screen Mirroring or Audio on your iPhone."
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button x:Name="DiscoveryButton"
                                                       Visibility="Collapsed"
                                                       Content="Start receiver"
                                                       Appearance="Primary"
                                                       Padding="18,9"
                                                       Click="Discovery_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Structured Two-Column Workspace Cards -->
                                    <Grid x:Name="HomeCardsGrid" Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="HomeCardSpacer" Width="16" />
                                            <ColumnDefinition x:Name="HomeCardCol2" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="HomeCardRowSpacer" Height="0" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Connect Card -->
                                        <Border x:Name="ConnectInstructions"
                                                Grid.Column="0"
                                                Grid.Row="0"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Connect from iPhone or iPad"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="Cast24" FontSize="16" Foreground="{DynamicResource AcousticLiveTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Screen Mirroring" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Name="ConnectMirrorHint" Text="Swipe into Control Center, tap Screen Mirroring, and choose NotAirplay." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{DynamicResource AcousticWaveCyanBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="AirPlay Audio" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="Open the AirPlay output icon in Control Center or Now Playing for speaker mode." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Wifi124" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="Same local Wi-Fi or Ethernet network. No iOS app required." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Capabilities & Standby Profile Card -->
                                        <Border x:Name="HomeCapabilitiesCard"
                                                Grid.Column="2"
                                                Grid.Row="0"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="Receiver pipeline"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Grid Margin="0,16,0,0" Typography.NumeralAlignment="Tabular">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="10" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="10" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="10" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Video" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock x:Name="HomeVideoModeText" Grid.Row="0" Grid.Column="1" Text="Direct3D 11 · H.264 / HEVC · 60 fps" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="ALAC lossless · AAC-ELD / LC" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Volume" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="WASAPI hardware sync" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Standby" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Persistent between audio tracks" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </StackPanel>

                                                <ui:Button x:Name="HomeDetailsButton"
                                                           Grid.Row="1"
                                                           Margin="0,16,0,0"
                                                           Appearance="Secondary"
                                                           HorizontalAlignment="Stretch"
                                                           Content="Open telemetry &amp; log"
                                                           Icon="{ui:SymbolIcon Pulse24}"
                                                           Click="Details_Click" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Desk Controls & Preferences Strip -->
                                    <Border Margin="0,16,0,0"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <StackPanel>
                                            <WrapPanel VerticalAlignment="Center">
                                                <StackPanel Margin="0,2,24,6">
                                                    <TextBlock Text="Receiver name"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,0,6" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:TextBox x:Name="ReceiverNameBox"
                                                                    Width="188"
                                                                    Height="34"
                                                                    PlaceholderText="NotAirplay"
                                                                    MaxLength="48"
                                                                    FontSize="12.5"
                                                                    Padding="10,0"
                                                                    VerticalContentAlignment="Center"
                                                                    TextChanged="ReceiverNameBox_TextChanged"
                                                                    KeyDown="ReceiverNameBox_KeyDown"
                                                                    AutomationProperties.Name="Custom receiver name" />
                                                        <ui:Button x:Name="ApplyNameButton"
                                                                   Content="Apply"
                                                                   Appearance="Secondary"
                                                                   Height="34"
                                                                   Margin="8,0,0,0"
                                                                   Padding="14,0"
                                                                   FontSize="12"
                                                                   IsEnabled="False"
                                                                   Click="ApplyName_Click"
                                                                   AutomationProperties.Name="Apply receiver name" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Margin="0,2,0,6">
                                                    <TextBlock Text="Frame rate"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,0,6" />
                                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Height="34"
                                                            Padding="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="Fps30Button"
                                                                         GroupName="TargetFps"
                                                                         Style="{StaticResource FpsSegmentButton}"
                                                                         Content="30 fps"
                                                                         Tag="30"
                                                                         Checked="FpsOption_Checked"
                                                                         AutomationProperties.Name="Frame rate 30 fps" />
                                                            <RadioButton x:Name="Fps60Button"
                                                                         GroupName="TargetFps"
                                                                         Style="{StaticResource FpsSegmentButton}"
                                                                         Content="60 fps"
                                                                         Tag="60"
                                                                         IsChecked="True"
                                                                         Margin="2,0,0,0"
                                                                         Checked="FpsOption_Checked"
                                                                         AutomationProperties.Name="Frame rate 60 fps" />
                                                            <RadioButton x:Name="Fps120Button"
                                                                         GroupName="TargetFps"
                                                                         Style="{StaticResource FpsSegmentButton}"
                                                                         Content="120 fps"
                                                                         Tag="120"
                                                                         Margin="2,0,0,0"
                                                                         Checked="FpsOption_Checked"
                                                                         AutomationProperties.Name="Frame rate 120 fps" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </WrapPanel>

                                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,10,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <ui:ToggleSwitch x:Name="HomePinToggle"
                                                                     Content="Keep window on top"
                                                                     Margin="0,2,24,2"
                                                                     Click="HomePinToggle_Click" />
                                                    <ui:ToggleSwitch x:Name="HomeCompatToggle"
                                                                     Content="FFmpeg compatibility fallback"
                                                                     Margin="0,2,0,2"
                                                                     Click="HomeCompatToggle_Click" />
                                                </WrapPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="F11 / Double-click: Full screen"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:DynamicScrollViewer>
                        </Grid>

                        <!-- View 2: Docked Acoustic Audio Deck -->
                        <Grid x:Name="AudioOnlyPanel" Visibility="Collapsed">
                            <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="28,24,28,24">
                                    <!-- Active Stream Identity Deck -->
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="24">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Acoustic Visualizer Emblem -->
                                            <Border Grid.Column="0"
                                                    Width="72"
                                                    Height="72"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{DynamicResource AcousticLiveBrush}" Margin="2,0" />
                                                    <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Fill="{DynamicResource AcousticWaveCyanBrush}" Margin="2,0" />
                                                    <Rectangle Width="4" Height="42" RadiusX="2" RadiusY="2" Fill="{DynamicResource AcousticLiveBrush}" Margin="2,0" />
                                                    <Rectangle Width="4" Height="24" RadiusX="2" RadiusY="2" Fill="{DynamicResource AcousticWaveCyanBrush}" Margin="2,0" />
                                                    <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="{DynamicResource AcousticLiveBrush}" Margin="2,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Device & Track Readout -->
                                            <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                                                <Border x:Name="AudioStateBadge"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Background="{DynamicResource AcousticLiveSubtleBrush}"
                                                        BorderBrush="{DynamicResource AcousticLiveBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="AudioStateDot" Width="6" Height="6" Fill="{DynamicResource AcousticLiveBrush}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="AudioStateBadgeText"
                                                                   Text="AirPlay Audio"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource AcousticLiveTextBrush}"
                                                                   Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock x:Name="AudioDeviceText"
                                                           Text="iPhone"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="AudioTrackText"
                                                           Text="AirPlay Audio"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Signal Details + Hardware Volume Grid -->
                                    <Grid x:Name="AudioCardsGrid" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="AudioCardSpacer" Width="16" />
                                            <ColumnDefinition x:Name="AudioCardCol2" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="AudioCardRowSpacer" Height="0" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Signal & Codec Card -->
                                        <Border Grid.Column="0"
                                                Grid.Row="0"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="DesktopSpeaker24" FontSize="17" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Signal pipeline" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Grid Margin="0,16,0,0" Typography.NumeralAlignment="Tabular">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="10" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="10" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock x:Name="AudioCodecText" Grid.Row="0" Grid.Column="1" Text="44.1 kHz Stereo · ALAC / AAC" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="AudioOutputCombo"
                                                              Grid.Row="2"
                                                              Grid.Column="1"
                                                              FontSize="12"
                                                              Padding="10,5"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              DropDownOpened="AudioOutputCombo_DropDownOpened"
                                                              SelectionChanged="AudioOutputCombo_SelectionChanged"
                                                              AutomationProperties.Name="Audio output device" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Standby" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Stays connected while paused" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- iOS Hardware Volume Meter Card -->
                                        <Border x:Name="AudioVolumeCard"
                                                Grid.Column="2"
                                                Grid.Row="0"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon x:Name="AudioVolumeIcon" Grid.Column="0" Symbol="Speaker224" FontSize="17" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Device volume" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AudioVolumeText"
                                                               Grid.Column="2"
                                                               Text="—"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <ProgressBar x:Name="AudioVolumeBar"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="0"
                                                             Height="6"
                                                             Margin="0,18,0,0"
                                                             Foreground="{DynamicResource AcousticLiveBrush}"
                                                             Background="{DynamicResource ControlFillColorSecondaryBrush}" />

                                                <TextBlock Text="Volume adjusts automatically from your iPhone side buttons or Control Center slider via WASAPI."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,12,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ui:DynamicScrollViewer>
                        </Grid>
                    </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>

            <!-- Live Video Mirroring Viewport (Kept permanently in visual tree outside NavigationView for unobstructed NativeSurface HWND) -->
            <Grid x:Name="VideoLayer"
                  Grid.Column="0"
                  Visibility="Hidden"
                  Background="#000000"
                  ClipToBounds="True"
                  MouseDown="Stage_MouseDown">
                <local:VideoSurface x:Name="NativeSurface" Visibility="Hidden" />
                <Image x:Name="MirrorImage" Visibility="Collapsed" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- Collapsible Fluent Session Telemetry Drawer -->
            <Border x:Name="DiagnosticsPanel"
                    Grid.Column="1"
                    Width="312"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Session telemetry"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Transparent"
                                   Padding="6,5"
                                   Click="Details_Click"
                                   ToolTip="Close details"
                                   AutomationProperties.Name="Close session details">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </ui:Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <TextBlock x:Name="StatsDetail"
                                   Text="No active session"
                                   FontSize="12"
                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,14,0,10">
                        <ui:Button x:Name="CompatibilityButton"
                                   Content="Compatibility mode: off"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Options24}"
                                   Click="Compatibility_Click" />
                        <TextBlock Text="Forces FFmpeg decode on your next connection if playback issues occur."
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />
                        <TextBlock Text="Activity log"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <TextBox x:Name="DiagnosticLog"
                                 Style="{x:Null}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Code, Consolas"
                                 FontSize="11"
                                 Typography.NumeralAlignment="Tabular"
                                 Padding="0" />
                    </Border>

                    <ui:Button Grid.Row="4"
                               Content="Copy diagnostics"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Copy24}"
                               Click="CopyDiagnostics_Click"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Compact Bottom Activity & Transport Bar -->
        <Grid x:Name="Footer" Grid.Row="2" Margin="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource AcousticOfflineBrush}" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusDetail"
                           Text="Same network. No cables."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="StopVideoButton"
                           Content="Stop mirroring"
                           Appearance="Danger"
                           Background="{DynamicResource AcousticDangerBrush}"
                           MouseOverBackground="{DynamicResource AcousticDangerHoverBrush}"
                           PressedBackground="{DynamicResource AcousticDangerPressedBrush}"
                           BorderBrush="{DynamicResource AcousticDangerBorderBrush}"
                           MouseOverBorderBrush="{DynamicResource AcousticDangerBorderBrush}"
                           Foreground="#FFFFFF"
                           Padding="12,5"
                           FontSize="12"
                           Visibility="Collapsed"
                           Margin="0,0,6,0"
                           Icon="{ui:SymbolIcon DismissCircle24}"
                           Click="StopVideo_Click" />
                <ui:Button x:Name="FullscreenButton"
                           Visibility="Collapsed"
                           Appearance="Transparent"
                           Padding="8,5"
                           Margin="0,0,4,0"
                           Click="Fullscreen_Click"
                           ToolTip="Full screen (F11)"
                           AutomationProperties.Name="Full screen">
                    <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="15" />
                </ui:Button>
                <ui:Button x:Name="DetailsButton"
                           Appearance="Transparent"
                           Padding="10,5"
                           FontSize="12"
                           Content="Details"
                           Icon="{ui:SymbolIcon Pulse24}"
                           Click="Details_Click"
                           AutomationProperties.Name="Session details" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
