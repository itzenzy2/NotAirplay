<Window x:Class="NotAirplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotAirplay"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NotAirplay" Width="960" Height="720" MinWidth="620" MinHeight="520"
        Background="#0B0C10" Foreground="#F1F2F6" FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" PreviewKeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8F93A4" />
        <SolidColorBrush x:Key="TextMuted" Color="#5F6375" />
        <SolidColorBrush x:Key="SurfaceCard" Color="#13141B" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#1A1C26" />
        <SolidColorBrush x:Key="SurfacePressed" Color="#232532" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#232532" />
        <SolidColorBrush x:Key="BorderHighlight" Color="#2E3142" />
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981" />
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8" />

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderHighlight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C53030" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#9B2C2C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="48" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar" Margin="16,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand Icon: Minimal AirPlay monitor glyph -->
                    <Border Width="28" Height="28" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="14" Height="9" Canvas.Left="1" Canvas.Top="1" RadiusX="2" RadiusY="2" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                            <Path Data="M 5,14 L 8,10 L 11,14 Z" Fill="{StaticResource TextPrimary}" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="NotAirplay" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status Capsule and Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource AccentEmerald}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Path Data="M 0,5 H 10" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 10 V 10 H 0 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Stage -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="Stage" Margin="16,0" Background="#0B0C10" MouseDown="Stage_MouseDown">
                    <!-- Video Layer (Hardware / Fallback surface) -->
                    <Grid x:Name="VideoLayer" Visibility="Hidden" Background="#000000" ClipToBounds="True">
                        <local:VideoSurface x:Name="NativeSurface" Visibility="Hidden" />
                        <Image x:Name="MirrorImage" Visibility="Collapsed" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <!-- Studio Audio Card -->
                    <Grid x:Name="AudioOnlyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="40,32" MaxWidth="440">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Waveform Visualizer Glyph -->
                                <Border Width="64" Height="64" Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentEmerald}" Margin="2,0" />
                                        <Rectangle Width="3" Height="26" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentCyan}" Margin="2,0" />
                                        <Rectangle Width="3" Height="38" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentEmerald}" Margin="2,0" />
                                        <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentCyan}" Margin="2,0" />
                                        <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentEmerald}" Margin="2,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="AudioDeviceText" Text="iPhone" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="AudioTrackText" Text="Connected · Ready to play" FontSize="13" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="380" TextWrapping="Wrap" />
                                <Border Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock x:Name="AudioVolumeText" Text="Volume 100%" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentEmerald}" TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Standby Home Screen -->
                    <Grid x:Name="ReceiverHome" MaxWidth="520" Margin="24,12" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="36,32">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Vector Illustration: Studio Display + Mobile Pairing -->
                                <Viewbox Width="160" Height="110" Margin="0,0,0,24" HorizontalAlignment="Center" Stretch="Uniform">
                                    <Canvas Width="160" Height="110">
                                        <!-- Desktop Display -->
                                        <Rectangle Canvas.Left="10" Canvas.Top="6" Width="120" Height="78" RadiusX="8" RadiusY="8" Stroke="{StaticResource BorderHighlight}" StrokeThickness="1.5" Fill="{StaticResource SurfaceHover}" />
                                        <Rectangle Canvas.Left="16" Canvas.Top="12" Width="108" Height="66" RadiusX="4" RadiusY="4" Fill="#0B0C10" />
                                        <!-- AirPlay Beacon Wave inside monitor -->
                                        <Path Data="M 64,48 L 70,40 L 76,48 Z" Fill="{StaticResource AccentEmerald}" />
                                        <Path Data="M 60,36 C 66,32 74,32 80,36" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M 54,30 C 64,24 76,24 86,30" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <!-- Display Stand -->
                                        <Path Data="M 58,84 V 96 H 82 V 84 M 46,96 H 94" Stroke="{StaticResource BorderHighlight}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                        <!-- Paired Mobile Device -->
                                        <Rectangle Canvas.Left="108" Canvas.Top="38" Width="42" Height="68" RadiusX="8" RadiusY="8" Fill="{StaticResource SurfaceCard}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" />
                                        <!-- Speaker notch -->
                                        <Rectangle Canvas.Left="123" Canvas.Top="43" Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextMuted}" />
                                        <!-- Mobile screen -->
                                        <Rectangle Canvas.Left="112" Canvas.Top="49" Width="34" Height="48" RadiusX="4" RadiusY="4" Fill="#0B0C10" />
                                        <!-- Home indicator -->
                                        <Path Data="M 124,101 H 134" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>

                                <TextBlock x:Name="HeroTitle" Text="Ready for your iPhone." FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="HeroDetail" Text="Open Control Center on your iPhone to connect." FontSize="13" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />

                                <Button x:Name="DiscoveryButton" Visibility="Collapsed" Content="Start receiver" Style="{StaticResource ButtonBase}" Background="{StaticResource TextPrimary}" Foreground="#0B0C10" Padding="20,9" HorizontalAlignment="Center" Margin="0,20,0,0" Click="Discovery_Click" />

                                <!-- Tactile 3-Step Connection Capsules -->
                                <StackPanel x:Name="ConnectInstructions" Visibility="Visible" Margin="0,24,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Quick connect" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Step 1 -->
                                        <Border Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,6,0" />
                                                <TextBlock Text="Control Center" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="›" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="8,0" VerticalAlignment="Center" />
                                        <!-- Step 2 -->
                                        <Border Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" Margin="0,0,6,0" />
                                                <TextBlock Text="Screen Mirroring / Audio" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="›" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="8,0" VerticalAlignment="Center" />
                                        <!-- Step 3 -->
                                        <Border Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,6,0" />
                                                <TextBlock Text="NotAirplay" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Diagnostics & Session Drawer -->
                <Border x:Name="DiagnosticsPanel" Grid.Column="1" Width="300" Visibility="Collapsed" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Session telemetry" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="StatsDetail" Text="No active session" FontSize="11" FontFamily="Cascadia Code, Consolas, Segoe UI" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,16,0,12">
                            <Button x:Name="CompatibilityButton" Content="Compatibility mode: off" Style="{StaticResource ButtonBase}" FontSize="11" Click="Compatibility_Click" />
                            <TextBlock Text="For playback issues. Applies to your next connection." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,14" />
                            <TextBlock Text="Activity log" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Border Grid.Row="2" Background="#0B0C10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8">
                            <TextBox x:Name="DiagnosticLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" FontFamily="Cascadia Code, Consolas" FontSize="10" Padding="0" />
                        </Border>
                        <Button Grid.Row="3" Content="Copy diagnostics" Style="{StaticResource ButtonBase}" Click="CopyDiagnostics_Click" Margin="0,12,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer Bar -->
            <Grid x:Name="Footer" Grid.Row="2" Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource AccentEmerald}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusDetail" Text="Same network. No cables." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StopVideoButton" Content="Stop mirroring" Visibility="Collapsed" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Click="StopVideo_Click" />
                    <Button x:Name="FullscreenButton" Visibility="Collapsed" Style="{StaticResource ToolButton}" Margin="0,0,4,0" Click="Fullscreen_Click" ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen">
                        <Path Data="M 0,4 V 0 H 4 M 8,0 H 12 V 4 M 12,8 V 12 H 8 M 4,12 H 0 V 8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource ToolButton}" Margin="0,0,4,0" Click="Pin_Click" ToolTip="Keep on top" AutomationProperties.Name="Keep on top">
                        <Path Data="M 3,0 H 9 L 8,5 L 11,8 H 1 L 4,5 Z M 6,8 V 13" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="Details" Click="Details_Click" AutomationProperties.Name="Session details" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
